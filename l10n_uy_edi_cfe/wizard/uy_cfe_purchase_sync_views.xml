<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="uy_cfe_purchase_sync_form_view" model="ir.ui.view">
            <field name="name">uy.cfe.purchase.sync.form</field>
            <field name="model">uy.cfe.purchase.sync</field>
            <field name="arch" type="xml">
                <form string="Synchronize Purchase Invoices">
                    <group>
                        <group>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <footer>
                        <button string='Synchronize' name="sync_purchase_invoices" type="object" class="btn-primary" />
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="uy_cfe_purchase_sync_act_window" model="ir.actions.act_window">
            <field name="name">Synchronize Purchase Invoices</field>
            <field name="res_model">uy.cfe.purchase.sync</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="uy_cfe_purchase_sync_form_view"/>
            <field name="target">new</field>
        </record>

        <menuitem name="Synchronize Purchase Invoices" id="uy_cfe_purchase_sync_menu"
                  parent="account.account_invoicing_menu"
                  groups="account.group_account_invoice,account.group_account_readonly"
                  action="uy_cfe_purchase_sync_act_window"/>

    </data>
</odoo>